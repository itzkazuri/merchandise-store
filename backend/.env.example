# ==========================================
# APPLICATION
# ==========================================
APP_NAME=Anime Merchandise Store
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# ==========================================
# SECURITY
# ==========================================
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_SECRET_KEY=CHANGE_THIS_TO_ANOTHER_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==========================================
# GOOGLE OAUTH 2.0 LOGIN
# ==========================================
# Dapatkan di https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_THIS_GOOGLE_CLIENT_SECRET

# Harus sama persis dengan "Authorized redirect URI" di Google Console
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Halaman frontend yang menerima token setelah login berhasil
GOOGLE_FRONTEND_REDIRECT_URI=http://localhost:5173/auth/google/callback

# Endpoint Google (biasanya tidak perlu diubah)
GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_USERINFO_URL=https://www.googleapis.com/oauth2/v3/userinfo
GOOGLE_SCOPES=openid email profile

# ==========================================
# MYSQL DATABASE
# ==========================================
# Backend jalan di host -> pakai 127.0.0.1.
# Kalau backend dijalankan sebagai container di network "devnet", ganti ke "mysql".
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=merchandise_db
DB_USER=root
DB_PASSWORD=CHANGE_THIS_PASSWORD

# SQLAlchemy
DATABASE_URL=mysql+pymysql://root:CHANGE_THIS_PASSWORD@127.0.0.1:3306/merchandise_db

# ==========================================
# REDIS
# ==========================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_PASSWORD
REDIS_DB=0

REDIS_URL=redis://:CHANGE_THIS_PASSWORD@127.0.0.1:6379/0

# ==========================================
# RUSTFS OBJECT STORAGE
# ==========================================
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000

S3_ACCESS_KEY=root
S3_SECRET_KEY=CHANGE_THIS_PASSWORD
S3_REGION=us-east-1

S3_BUCKET_PRODUCTS=products
S3_BUCKET_PRIVATE=private
S3_USE_SSL=false

# ==========================================
# MIDTRANS PAYMENT GATEWAY
# ==========================================
MIDTRANS_IS_PRODUCTION=false

MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxx
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxx

MIDTRANS_SNAP_API_URL=https://app.sandbox.midtrans.com/snap/v1/transactions
MIDTRANS_SNAP_JS_URL=https://app.sandbox.midtrans.com/snap/snap.js

# ==========================================
# PAYMENT CALLBACK
# ==========================================
MIDTRANS_NOTIFICATION_URL=https://api.example.com/api/v1/payments/midtrans/notification

# ==========================================
# CORS
# ==========================================
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ==========================================
# ORDER / CHECKOUT
# ==========================================
ORDER_PREFIX=INV
ORDER_CURRENCY=IDR
DEFAULT_SHIPPING_COST=0
