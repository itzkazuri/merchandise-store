# ==========================================
# APP
# ==========================================
VITE_APP_NAME=Anime Merchandise Store
VITE_APP_DESCRIPTION=Toko merchandise anime: katalog, keranjang, checkout, dan pembayaran.

# ==========================================
# BACKEND API
# ==========================================
# Samakan dengan backend/.env -> CORS_ORIGINS & FRONTEND_URL
VITE_API_ORIGIN=http://localhost:8000
VITE_API_BASE_URL=${VITE_API_ORIGIN}/api/v1
VITE_SITE_URL=http://localhost:4173

# ==========================================
# AUTH
# ==========================================
VITE_GOOGLE_LOGIN_URL=${VITE_API_BASE_URL}/auth/google/login
VITE_TOKEN_STORAGE_KEY=merch.auth
VITE_ACCESS_TOKEN_TTL_MINUTES=30
VITE_REFRESH_TOKEN_TTL_DAYS=7

# ==========================================
# MIDTRANS (Snap)
# ==========================================
# Isi dengan client key dari dashboard Midtrans.
VITE_MIDTRANS_CLIENT_KEY=CHANGE_THIS_MIDTRANS_CLIENT_KEY
VITE_MIDTRANS_SNAP_JS_URL=https://app.sandbox.midtrans.com/snap/snap.js
VITE_MIDTRANS_IS_PRODUCTION=false

# ==========================================
# STORE
# ==========================================
VITE_CURRENCY=IDR
VITE_LOCALE=id-ID
VITE_TIMEZONE=Asia/Jakarta
VITE_DEFAULT_PAGE_SIZE=20
VITE_MAX_UPLOAD_MB=5

# Data demo terpisah dari API. Aktif otomatis di mode development.
# Set true untuk memakai katalog contoh saat preview/debug build production.
VITE_ENABLE_DEMO_CATALOG=false

# ==========================================
# MEDIA / GAMBAR PRODUK (opsional)
# ==========================================
# Base URL publik object storage (RustFS/S3). API sudah mengirim URL publik,
# set ke origin S3_PUBLIC_ENDPOINT backend/.env. Untuk dev lokal: http://127.0.0.1:9000
VITE_STORAGE_ORIGIN=
VITE_MEDIA_BASE_URL=${VITE_STORAGE_ORIGIN}
# Host gambar tambahan yang boleh dioptimasi (host:port, pisahkan koma).
# Untuk produksi isi domain storage publik, mis. storage.example.com
VITE_IMAGE_ALLOWED_HOSTS=
# Optimasi gambar on-demand di Vite dev/preview: PNG/JPG besar -> WebP kecil.
# Kosongkan untuk memakai URL gambar asli tanpa optimizer.
VITE_IMAGE_OPTIMIZER_URL_TEMPLATE=/media?url={url}&w={width}&q={quality}
VITE_IMAGE_QUALITY=75
