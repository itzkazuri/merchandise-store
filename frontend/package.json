{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" -- && bun run assets:download && bun run seo:prerender",
    "preview": "vite preview",
    "build-only": "vite build",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/entry-server.ts --outDir dist/server",
    "build:ssr": "bun run build && bun run build:server",
    "type-check": "vue-tsc --build",
    "seo:prerender": "bun scripts/prerender-products.ts",
    "assets:download": "bun scripts/download-fonts.ts"
  },
  "dependencies": {
    "@unhead/vue": "^3.4.3",
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "npm-run-all2": "^9.0.3",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
